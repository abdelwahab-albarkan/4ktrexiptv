---

<section class="apps-master-section" id={id}>
  <div class="container" style="max-width: 1360px; margin: 0 auto; padding: 0 24px;">
    <!-- Section Header -->
    <div class="section-header text-center" style="max-width: 900px; margin: 0 auto 50px;">
      <span class="section-badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 6px 16px; border-radius: 9999px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-play"></i> Comprehensive Player & App Guide
      </span>
      <h2 class="section-title" style="font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 800; color: #fff; margin: 16px 0 12px; letter-spacing: -0.02em;">
        {title}
      </h2>
      <p class="section-description" style="font-size: 1.05rem; color: #94a3b8; line-height: 1.6;">
        {subtitle}
      </p>

      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 20px;">
        <span class="hub-pill"><i class="fa-solid fa-fire" style="color: #f97316;"></i> Downloader Shortcodes</span>
        <span class="hub-pill"><i class="fa-solid fa-tv" style="color: #38bdf8;"></i> Samsung & LG Smart TV Apps</span>
        <span class="hub-pill"><i class="fa-brands fa-apple" style="color: #cbd5e1;"></i> Apple TV 4K & iOS</span>
        <span class="hub-pill"><i class="fa-brands fa-android" style="color: #22c55e;"></i> Firestick & Android TV</span>
        <span class="hub-pill"><i class="fa-solid fa-key" style="color: #eab308;"></i> 19 MAC Portal Apps</span>
      </div>
    </div>

    <!-- The 10 Master IPTV Players Deep Dive -->
    <div class="master-players-header">
      <h3 style="font-size: 1.6rem; color: #fff; font-weight: 800; display: flex; align-items: center; gap: 12px;">
        <i class="fa-solid fa-crown" style="color: #f59e0b;"></i> Top 10 IPTV Players: In-Depth Reviews & Setup Guides
      </h3>
      <p style="color: #94a3b8; font-size: 0.95rem; margin-top: 4px;">
        Tested for hardware acceleration, sub-second channel zapping, EPG program guides, and multi-screen streaming.
      </p>
    </div>

    <div class="top-players-grid">
      {TOP_10_PLAYERS.map((app, idx) => (
        <article class="top-player-card">
          <div class="player-card-header">
            <div class="player-idx-badge">#{idx + 1}</div>
            <div class="player-title-box">
              <h4>{app.name}</h4>
              <span class="player-tagline">{app.badge}</span>
            </div>
            <div class="player-rating-box">
              <span class="stars"><i class="fa-solid fa-star"></i> {app.rating}</span>
              <small>({app.reviews})</small>
            </div>
          </div>

          <!-- Downloader Code Callout -->
          <div class="downloader-callout">
            <div class="dl-info">
              <i class="fa-solid fa-download"></i>
              <span>Firestick Downloader Code:</span>
            </div>
            <strong class="dl-code">{app.downloaderCode}</strong>
          </div>

          <!-- Description -->
          <p class="player-review-text">{app.review}</p>

          <!-- Pros Checklist -->
          <div class="player-pros-box">
            <span class="pros-title"><i class="fa-solid fa-thumbs-up"></i> Key Advantages:</span>
            <ul>
              {app.pros.map(pro => (
                <li><i class="fa-solid fa-check"></i> {pro}</li>
              ))}
            </ul>
          </div>

          <!-- Setup Steps -->
          <div class="player-steps-box">
            <span class="steps-title"><i class="fa-solid fa-list-ol"></i> Fast 3-Step Setup:</span>
            <ol>
              {app.steps.map(step => (
                <li>{step}</li>
              ))}
            </ol>
          </div>

          <!-- Supported Platforms -->
          <div class="player-platforms-row">
            <span class="platforms-label"><i class="fa-solid fa-display"></i> Supported:</span>
            <div class="platforms-tags">
              {app.platforms.map(p => (
                <span class="plat-tag">{p}</span>
              ))}
            </div>
          </div>

          <!-- Target SEO Keywords Cloud -->
          <div class="player-keywords-box">
            <span class="kw-title"><i class="fa-solid fa-magnifying-glass-chart"></i> Target SEO Keywords:</span>
            <div class="kw-cloud">
              {app.keywords.map(kw => (
                <span class="kw-pill">{kw}</span>
              ))}
            </div>
          </div>

          <!-- Action CTA -->
          <div class="player-card-footer">
            <a
              href={`${whatsappOrderBase}${encodeURIComponent(`Bonjour, j'utilise l'application ${app.name} et je souhaite commander un abonnement IPTV compatible ou un test 24h.`)}`}
              class="btn-get-app-subscription"
              target="_blank"
              rel="nofollow noopener noreferrer"
            >
              <i class="fa-brands fa-whatsapp"></i> Get Subscription for {app.name}
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- The 19 Smart TV MAC Portal Apps Grid (From User Screenshot) -->
    <div class="screenshot-portal-section" id="smart-tv-portal-apps">
      <div class="portal-header text-center">
        <span class="section-badge" style="background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); padding: 5px 14px; border-radius: 9999px; font-weight: 700; font-size: 0.8rem;">
          <i class="fa-solid fa-tv"></i> Smart TV MAC Portal Ecosystem
        </span>
        <h3 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin: 12px 0 8px;">
          19 Supported Smart TV MAC Portal Applications
        </h3>
        <p style="color: #94a3b8; font-size: 0.95rem; max-width: 800px; margin: 0 auto 30px;">
          All 19 portal applications shown in your portal dashboard are 100% supported by our servers. Simply provide your TV MAC Address or Device Key via WhatsApp for instant activation.
        </p>
      </div>

      <div class="screenshot-portal-grid">
        {SCREENSHOT_PORTAL_APPS.map((pApp, pIdx) => (
          <div class="portal-app-card">
            <div class="portal-app-top">
              <span class="portal-number">#{pIdx + 1}</span>
              <span class="portal-tag">{pApp.tag}</span>
            </div>
            <div class="portal-app-body">
              <div class="portal-icon-wrap">
                <i class={`fa-solid ${pApp.icon}`}></i>
              </div>
              <h4 class="portal-name">{pApp.name}</h4>
              <p class="portal-note">{pApp.note}</p>
            </div>
            <a
              href={`${whatsappOrderBase}${encodeURIComponent(`Bonjour, je souhaite activer mon application ${pApp.name} avec mon adresse MAC / Device Key.`)}`}
              class="btn-activate-portal"
              target="_blank"
              rel="nofollow noopener noreferrer"
            >
              <i class="fa-solid fa-bolt"></i> Activate {pApp.name}
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .apps-master-section {
    padding: 80px 0;
    background: #090d1a;
    border-top: 1px solid rgba(56, 189, 248, 0.15);
    border-bottom: 1px solid rgba(56, 189, 248, 0.15);
  }

  .hub-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .master-players-header {
    margin-bottom: 30px;
  }

  .top-players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: 26px;
    margin-bottom: 70px;
  }

  .top-player-card {
    background: linear-gradient(165deg, rgba(15, 23, 42, 0.85) 0%, rgba(10, 15, 29, 0.95) 100%);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 20px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .top-player-card:hover {
    transform: translateY(-5px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 20px 40px -10px rgba(56, 189, 248, 0.2);
  }

  .player-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .player-idx-badge {
    background: #0284c7;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 6px 10px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .player-title-box {
    flex-grow: 1;
  }

  .player-title-box h4 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 2px;
  }

  .player-tagline {
    font-size: 0.78rem;
    color: #38bdf8;
    font-weight: 600;
  }

  .player-rating-box {
    text-align: right;
    font-size: 0.85rem;
  }

  .player-rating-box .stars {
    color: #fbbf24;
    font-weight: 700;
    display: block;
  }

  .player-rating-box small {
    color: #64748b;
    font-size: 0.75rem;
  }

  .downloader-callout {
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .dl-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #fed7aa;
    font-weight: 600;
  }

  .dl-info i {
    color: #f97316;
  }

