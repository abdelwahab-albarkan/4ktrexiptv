---
import { SITE, PLANS } from '../config';

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  badgeText?: string;
  contextKeyword?: string;
}

const {
  id = 'pricing',
  title = `Premium IPTV Subscription Plans (${SITE.year})`,
  subtitle = 'Choose your subscription term and number of simultaneous connections (1 to 4 devices). Instant WhatsApp delivery with 99.98% anti-freeze server uptime.',
  badgeText = 'Direct Subscription Pricing',
  contextKeyword = '',
} = Astro.props;

const de = SITE.locale === 'de';

const accountTabs = [
  { count: 1, label: de ? '1 Zugang' : '1 Account', sub: de ? '1 Gerät' : '1 Device' },
  { count: 2, label: de ? '2 Zugänge' : '2 Accounts', sub: de ? '2 Geräte' : '2 Devices' },
  { count: 3, label: de ? '3 Zugänge' : '3 Accounts', sub: de ? '3 Geräte' : '3 Devices' },
  { count: 4, label: de ? '4 Zugänge' : '4 Accounts', sub: de ? '4 Geräte' : '4 Devices' },
];

const featuresList = de ? [
  'Über 51.000 Live-Sender weltweit (4K / 8K / UHD)',
  'Über 200.000 Filme & Serien (VOD) auf Abruf',
  'Alle 47 IPTV-Server unterstützt (Trex, Forever, Zen 4K, Strong, Iron)',
  'Alle PPV-Live-Events & Sportsender inklusive',
  'Anti-Freeze Technologie 9.8 (99,98% Server-Verfügbarkeit)',
  'Elektronischer Programmführer (EPG) & 7 Tage Replay',
  'Kompatibel mit Firestick, Smart TV, Android, iOS & PC',
  'Blitzschnelle Aktivierung in unter 3 Minuten per WhatsApp',
] : [
  '51,000+ Live Channels Worldwide (4K / 8K / UHD)',
  '200,000+ Movies & Complete TV Series (VOD)',
  'All 47 IPTV Servers Supported (Trex, Forever, Zen 4K, Strong, Iron)',
  'All Major PPV Sports Included (UFC, Boxing, NFL, EPL, Champions League)',
  'Anti-Freeze Tech 9.8 with 99.98% Server SLA Uptime',
  'EPG TV Guide with 7-Day Catch-Up TV',
  'Works on Firestick, Smart TVs, Android, Apple TV & PC',
  'Instant Activation via WhatsApp in Under 3 Minutes',
];
---

<section class="section-padding subscription-pricing-section" id={id} style="padding: 80px 0; position: relative;">
  <div class="container" style="max-width: 1320px; margin: 0 auto; padding: 0 24px;">
    <!-- Section Header -->
    <div class="section-header text-center" style="max-width: 820px; margin: 0 auto 36px;">
      <span class="section-badge"><i class="fa-solid fa-gem"></i> {badgeText}</span>
      <h2 class="section-title" style="font-size: clamp(2rem, 3.5vw, 2.75rem); margin-top: 12px; line-height: 1.25;">
        {title} {contextKeyword ? `– ${contextKeyword}` : ''}
      </h2>
      <p class="section-description" style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin-top: 14px;">
        {subtitle}
      </p>
    </div>

    <!-- Account / Connection Selector Switcher -->
    <div class="pricing-switcher-wrapper" style="text-align: center; margin-bottom: 40px;">
      <div class="pricing-switcher-label" style="font-size: 0.95rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary-light); margin-bottom: 14px;">
        <i class="fa-solid fa-sliders"></i> {de ? 'Gleichzeitige Zugänge wählen:' : 'Select Simultaneous Connections:'}
      </div>
      <div class="pricing-switcher-tabs" role="tablist" aria-label="Simultaneous connections switcher">
        {accountTabs.map((tab, idx) => (
          <button
            type="button"
            class={`pricing-switcher-btn ${idx === 0 ? 'active' : ''}`}
            data-accounts={tab.count}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-label={`${tab.label} (${tab.sub})`}
          >
            <span class="btn-tab-count">{tab.count}</span>
            <span class="btn-tab-content">
              <strong>{tab.label}</strong>
              <small>{tab.sub}</small>
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="subscription-pricing-grid">
      {PLANS.map((plan) => {
        const defaultTier = plan.tiers[0];
        const defaultOrderMsg = encodeURIComponent(
          `Hello, I would like to order the ${plan.name} IPTV Subscription for 1 Account ($${defaultTier.rawPrice.toFixed(2)})`
        );
        const orderUrl = `${SITE.orderUrl}?text=${defaultOrderMsg}`;

        return (
          <div
            class={`pricing-card-v2 ${plan.featured ? 'featured' : ''}`}
            data-plan-months={plan.months}
            data-plan-name={plan.name}
          >
            {/* Badges */}
            <div class="card-badge-container">
              {plan.badge && (
                <span class={`card-main-badge ${plan.featured ? 'popular-badge' : 'standard-badge'}`}>
                  <i class={`fa-solid ${plan.featured ? 'fa-crown' : plan.months === 12 ? 'fa-fire' : 'fa-bolt'}`}></i>
                  {plan.badge}
                </span>
              )}
              {plan.savings && (
                <span class="card-savings-pill">{plan.savings}</span>
              )}
            </div>

            {/* Plan Header */}
            <div class="card-head">
              <h3 class="card-title">{plan.name}</h3>
              <p class="card-subtitle">{plan.note}</p>
            </div>

            {/* Big Interactive Price Display */}
            <div class="card-price-block">
              <div class="price-row">
                <span class="currency-symbol">$</span>
                <span class="price-value" data-price-value>{defaultTier.rawPrice.toFixed(2)}</span>
                <span class="price-period-label">/ {plan.months} {de ? 'Monate' : 'mo'}</span>
              </div>
              <div class="per-month-indicator">
                <i class="fa-solid fa-tag"></i>
                <span class="per-month-text" data-per-month>{defaultTier.perMonth}</span>
                <span class="effective-text">{de ? 'effektiv' : 'effective'}</span>
              </div>
            </div>

            {/* Account Quick Selector Pills inside card */}
            <div class="card-account-tiers">
              <div class="tiers-header">
                <span>{de ? 'Tarif nach Zugängen:' : 'Pricing by Accounts:'}</span>
              </div>
              <div class="tiers-chip-grid">
                {plan.tiers.map((tier, tIdx) => (
                  <button
                    type="button"
                    class={`tier-chip ${tIdx === 0 ? 'active' : ''}`}
                    data-tier-accounts={tier.accounts}
                    data-tier-price={tier.rawPrice.toFixed(2)}
                    data-tier-per={tier.perMonth}
                    title={`${tier.label}: ${tier.price}`}
                  >
                    <span class="chip-acc">{tier.accounts} {de ? 'Acc' : 'Acc'}</span>
                    <span class="chip-price">{tier.price}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Card Features List */}
            <div class="card-features">
              <div class="features-header">
                <i class="fa-solid fa-circle-check" style="color: var(--success-light);"></i>
                <span>{de ? 'Alles Inklusive:' : "Everything Included:"}</span>
              </div>
              <ul class="features-list">
                {featuresList.map((f) => (
                  <li>
                    <i class="fa-solid fa-check"></i>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* Dynamic CTA Button */}
            <div class="card-action">
              <a
                href={orderUrl}
                class={`btn full-width ${plan.featured ? 'btn-primary' : 'btn-whatsapp'} btn-lg`}
                target="_blank"
                rel="nofollow noopener noreferrer"
                data-order-btn
              >
                <i class="fa-brands fa-whatsapp"></i>
                <span>{de ? `Auf WhatsApp Bestellen` : `Order ${plan.name} on WhatsApp`}</span>
              </a>
              <div class="action-hint">
                <i class="fa-solid fa-shield-halved"></i>
                <span>{de ? 'Einmalige Zahlung • Kein Abo-Zwang' : 'One-time payment • No auto-rebill'}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Trust & Guarantee Ribbon -->
    <div class="pricing-trust-ribbon">
      <div class="trust-item">
        <i class="fa-solid fa-bolt" style="color: var(--warning-light);"></i>
        <div>
          <strong>{de ? 'Sofortige WhatsApp-Lieferung' : 'Instant WhatsApp Delivery'}</strong>
          <span>{de ? 'Zugangsdaten in unter 3 Min' : 'Login credentials sent in < 3 mins'}</span>
        </div>
      </div>
      <div class="trust-item">
        <i class="fa-solid fa-lock-open" style="color: var(--success-light);"></i>
        <div>
          <strong>{de ? 'Keine automatische Verlängerung' : 'No Auto-Renewals'}</strong>
          <span>{de ? 'Sie behalten 100% Kontrolle' : 'You stay in 100% control of renewals'}</span>
        </div>
      </div>
      <div class="trust-item">
        <i class="fa-solid fa-server" style="color: var(--secondary-light);"></i>
        <div>
          <strong>{de ? '99,98% Server-Uptime' : '99.98% Server SLA'}</strong>
          <span>{de ? 'Anti-Freeze 9.8 Technologie' : 'Anti-Freeze 9.8 streaming clusters'}</span>
        </div>
      </div>
      <div class="trust-item">
        <i class="fa-solid fa-headset" style="color: var(--primary-light);"></i>
        <div>
          <strong>{de ? '24/7 VIP-Support' : '24/7 VIP Support'}</strong>
          <span>{de ? 'Direkter WhatsApp-Kundenservice' : 'Direct human assistance anytime'}</span>
        </div>
      </div>
    </div>

    <!-- Free Trial Banner Card -->
    <div class="pricing-trial-callout">
      <div class="trial-callout-content">
        <div class="trial-icon">
          <i class="fa-solid fa-crown"></i>
        </div>
        <div class="trial-text">
          <h3>{de ? '12 Monate VIP-Abonnement bestellen?' : 'Looking for the Best IPTV Deal?'}</h3>
          <p>
            {de
              ? 'Erhalten Sie sofortigen Zugriff auf alle 20.000+ Sender und VOD mit WhatsApp-Aktivierung in 2 Minuten.'
              : 'Get full access to all 20,000+ live channels, sports packages, and 4K VOD cinema with instant WhatsApp activation in 2 minutes.'}
          </p>
        </div>
      </div>
      <div class="trial-callout-action">
        <a href={SITE.buy1YearUrl} class="btn btn-secondary btn-lg" target="_blank" rel="nofollow noopener noreferrer">
          <i class="fa-brands fa-whatsapp"></i> {de ? '1-Jahres-Abo Kaufen' : 'Buy Subscription 1 Year'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .subscription-pricing-section {
    background: radial-gradient(circle at 50% 0%, rgba(108, 92, 231, 0.08) 0%, transparent 60%);
  }

  /* Switcher Tabs */
  .pricing-switcher-tabs {
    display: inline-flex;
    background: rgba(17, 24, 39, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    padding: 6px;
    gap: 6px;
    box-shadow: var(--shadow-md), 0 0 20px rgba(0, 0, 0, 0.4);
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .pricing-switcher-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 10px 22px;
    border-radius: var(--radius-full);
    cursor: pointer;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .pricing-switcher-btn .btn-tab-count {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 800;
    transition: all var(--transition-base);
  }

  .pricing-switcher-btn .btn-tab-content {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.15;
  }

  .pricing-switcher-btn .btn-tab-content strong {
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 700;
  }

  .pricing-switcher-btn .btn-tab-content small {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .pricing-switcher-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .pricing-switcher-btn.active {
    background: var(--gradient-primary);
    color: #ffffff;
    box-shadow: var(--shadow-primary);
  }

  .pricing-switcher-btn.active .btn-tab-count {
    background: #ffffff;
    color: var(--primary);
  }

  .pricing-switcher-btn.active .btn-tab-content small {
    color: rgba(255, 255, 255, 0.85);
  }

  /* Grid Layout */
  .subscription-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: stretch;
    margin-bottom: 50px;
  }

  @media (max-width: 1024px) {
    .subscription-pricing-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 580px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Pricing Cards */
  .pricing-card-v2 {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-2xl);
    padding: 38px 30px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-lg);
  }

  .pricing-card-v2:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: var(--shadow-xl), 0 0 30px rgba(108, 92, 231, 0.2);
  }

  .pricing-card-v2.featured {
    border: 2px solid var(--primary);
    box-shadow: var(--shadow-primary), 0 0 45px rgba(108, 92, 231, 0.35);
    background: linear-gradient(180deg, rgba(30, 36, 58, 0.92) 0%, rgba(17, 24, 39, 0.96) 100%);
    transform: scale(1.03);
    z-index: 2;
  }

  .pricing-card-v2.featured:hover {
    transform: scale(1.03) translateY(-8px);
    box-shadow: var(--shadow-primary), 0 0 60px rgba(108, 92, 231, 0.5);
  }

  @media (max-width: 1024px) {
    .pricing-card-v2.featured {
      transform: none;
    }
    .pricing-card-v2.featured:hover {
      transform: translateY(-8px);
    }
  }

  /* Badges */
  .card-badge-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    min-height: 28px;
  }

  .card-main-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: var(--radius-full);
  }

  .popular-badge {
    background: var(--gradient-primary);
    color: #ffffff;
    box-shadow: var(--shadow-primary);
  }

  .standard-badge {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .card-savings-pill {
    background: rgba(0, 184, 148, 0.15);
    color: var(--success-light);
    border: 1px solid rgba(0, 184, 148, 0.35);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
  }

  /* Card Head */
  .card-head {
    margin-bottom: 22px;
  }

  .card-title {
    font-size: 1.85rem;
    margin: 0 0 6px;
    color: #ffffff;
    font-weight: 800;
  }

  .card-subtitle {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Price Display */
  .card-price-block {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-lg);
    padding: 20px;
    margin-bottom: 24px;
    text-align: center;
    transition: all var(--transition-fast);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin-bottom: 6px;
  }

  .currency-symbol {
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--primary-light);
  }

  .price-value {
    font-size: 3rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .price-period-label {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .per-month-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    color: var(--secondary-light);
    font-weight: 600;
    background: rgba(0, 206, 201, 0.1);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .per-month-text {
    font-weight: 800;
  }

  .effective-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* Account Tiers Grid inside card */
  .card-account-tiers {
    margin-bottom: 26px;
  }

  .tiers-header {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 10px;
    text-align: left;
  }

  .tiers-chip-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tier-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 8px 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: inherit;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .tier-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  .tier-chip.active {
    background: rgba(108, 92, 231, 0.2);
    border-color: var(--primary-light);
    color: #ffffff;
    box-shadow: 0 0 12px rgba(108, 92, 231, 0.35);
  }

  .chip-acc {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .chip-price {
    font-size: 0.88rem;
    font-weight: 800;
    color: #ffffff;
  }

  .tier-chip.active .chip-price {
    color: var(--secondary-light);
  }

  /* Features */
  .card-features {
    margin-bottom: 30px;
    flex-grow: 1;
  }

  .features-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .features-list li i {
    color: var(--success);
    font-size: 0.85rem;
    margin-top: 4px;
    flex-shrink: 0;
  }

  /* Action Button */
  .card-action {
    margin-top: auto;
  }

  .card-action .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 20px;
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .card-action .btn-whatsapp {
    background: #25d366;
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 18px rgba(37, 211, 102, 0.35);
  }

  .card-action .btn-whatsapp:hover {
    background: #20ba59;
    box-shadow: 0 6px 25px rgba(37, 211, 102, 0.5);
    transform: translateY(-2px);
  }

  .card-action .btn-primary {
    background: var(--gradient-primary);
    color: #ffffff;
    border: none;
    box-shadow: var(--shadow-primary);
  }

  .card-action .btn-primary:hover {
    box-shadow: 0 6px 30px rgba(108, 92, 231, 0.6);
    transform: translateY(-2px);
  }

  .action-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 12px;
    text-align: center;
  }

  .action-hint i {
    color: var(--success-light);
  }

  /* Trust Ribbon */
  .pricing-trust-ribbon {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    padding: 24px 30px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    margin-bottom: 40px;
  }

  @media (max-width: 900px) {
    .pricing-trust-ribbon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .pricing-trust-ribbon {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .trust-item i {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .trust-item div {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .trust-item strong {
    font-size: 0.92rem;
    color: #ffffff;
  }

  .trust-item span {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Trial Callout Banner */
  .pricing-trial-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 36px;
    background: linear-gradient(135deg, rgba(108, 92, 231, 0.15) 0%, rgba(0, 206, 201, 0.1) 100%);
    border: 1px solid rgba(108, 92, 231, 0.35);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 768px) {
