</style>

<script is:inline>
  (function () {
    const plansData = {
      3: {
        name: '3 Months',
        1: { price: '39.99', per: '$13.33/mo' },
        2: { price: '59.99', per: '$10.00/acc/mo' },
        3: { price: '79.99', per: '$8.89/acc/mo' },
        4: { price: '99.99', per: '$8.33/acc/mo' },
      },
      6: {
        name: '6 Months',
        1: { price: '56.99', per: '$9.50/mo' },
        2: { price: '84.99', per: '$7.08/acc/mo' },
        3: { price: '109.99', per: '$6.11/acc/mo' },
        4: { price: '134.99', per: '$5.62/acc/mo' },
      },
      12: {
        name: '12 Months',
        1: { price: '79.99', per: '$6.66/mo' },
        2: { price: '119.99', per: '$5.00/acc/mo' },
        3: { price: '149.99', per: '$4.16/acc/mo' },
        4: { price: '179.99', per: '$3.75/acc/mo' },
      },
    };

    const whatsappBase = 'https://wa.me/212625218443';

    function setAccounts(accountCount) {
      const switcherBtns = document.querySelectorAll('.pricing-switcher-btn');
      switcherBtns.forEach((btn) => {
        const count = parseInt(btn.getAttribute('data-accounts'), 10);
        if (count === accountCount) {
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        }
      });

      const cards = document.querySelectorAll('.pricing-card-v2');
      cards.forEach((card) => {
        const months = parseInt(card.getAttribute('data-plan-months'), 10);
        const plan = plansData[months];
        if (!plan) return;

        const tier = plan[accountCount];
        if (!tier) return;

        // Animate price update
        const priceValEl = card.querySelector('[data-price-value]');
        if (priceValEl) {
          priceValEl.style.opacity = '0.3';
          priceValEl.style.transform = 'translateY(-4px)';
          setTimeout(() => {
            priceValEl.textContent = tier.price;
            priceValEl.style.opacity = '1';
            priceValEl.style.transform = 'translateY(0)';
          }, 120);
        }

        const perMonthEl = card.querySelector('[data-per-month]');
        if (perMonthEl) {
          perMonthEl.textContent = tier.per;
        }

        // Update active chip inside card
        const chips = card.querySelectorAll('.tier-chip');
        chips.forEach((chip) => {
          const cCount = parseInt(chip.getAttribute('data-tier-accounts'), 10);
          if (cCount === accountCount) {
            chip.classList.add('active');
          } else {
            chip.classList.remove('active');
          }
        });

        // Update WhatsApp Order Link
        const orderBtn = card.querySelector('[data-order-btn]');
        if (orderBtn) {
          const accLabel = accountCount === 1 ? '1 Account' : `${accountCount} Accounts`;
          const text = encodeURIComponent(
            `Hello, I would like to order the ${plan.name} IPTV Subscription for ${accLabel} ($${tier.price})`
          );
          orderBtn.setAttribute('href', `${whatsappBase}?text=${text}`);
        }
      });
    }

    // Attach click events
    document.addEventListener('DOMContentLoaded', () => {
      const switcherBtns = document.querySelectorAll('.pricing-switcher-btn');
      switcherBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const count = parseInt(btn.getAttribute('data-accounts'), 10);
          setAccounts(count);
        });
      });

      const chips = document.querySelectorAll('.tier-chip');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const count = parseInt(chip.getAttribute('data-tier-accounts'), 10);
          setAccounts(count);
        });
      });
    });
  })();
</script>
