<script is:inline>
  (function initServersDirectory() {
    const searchInput = document.getElementById('serverCatalogSearch');
    const clearBtn = document.getElementById('clearServerSearch');
    const filterBtns = document.querySelectorAll('.cat-filter-btn');
    const cardsGrid = document.getElementById('serversCardsGrid');
    const cards = Array.from(cardsGrid ? cardsGrid.querySelectorAll('.server-card') : []);
    const countDisplay = document.getElementById('serversResultsCount');
    const noResults = document.getElementById('noServersFound');
    const resetBtn = document.getElementById('resetServersFilter');

    let currentCategory = 'all';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;
      const q = searchQuery.trim().toLowerCase();

      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const name = card.getAttribute('data-name') || '';
        const alt = card.getAttribute('data-alt') || '';
        const kw = card.getAttribute('data-keywords') || '';
        const text = card.textContent.toLowerCase();

        const matchCat = (currentCategory === 'all' || cat === currentCategory);
        const matchSearch = (!q || name.includes(q) || alt.includes(q) || kw.includes(q) || text.includes(q));

        if (matchCat && matchSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.innerHTML = `Showing <strong>${visibleCount}</strong> of ${cards.length} IPTV Servers`;
      }

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (clearBtn) {
        clearBtn.style.display = q ? 'flex' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        applyFilter();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          applyFilter();
          searchInput.focus();
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-cat') || 'all';
        applyFilter();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentCategory = 'all';
        filterBtns.forEach(b => {
          if (b.getAttribute('data-cat') === 'all') b.classList.add('active');
          else b.classList.remove('active');
        });
        applyFilter();
      });
    }
  })();
</script>
