---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import PricingSection from '../components/PricingSection.astro';
import { SITE, PLANS } from '../config';
import { T } from '../i18n';
import { ALL, byCategory } from '../lib/pages';
import { buildContent, titleCase } from '../lib/content';
import { heroImageFor, inlineImageFor } from '../lib/images';
import { enrichContextLinks, getClusterLinks } from '../lib/links';

import { hash } from '../lib/util';

export function getStaticPaths() {
  return ALL.map(p => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const c = buildContent(p);
const heroKey = heroImageFor(p);
const inlineKey = inlineImageFor(p, heroKey);
const catTitle = T.categories[p.category]?.title || titleCase(p.category);
const url = new URL(Astro.url.pathname, SITE.url).href;
const isDe = SITE.locale === 'de';
const isCommercial = (p.category === 'pricing' || p.category === 'reseller' || p.intent === 'transactional') && (p.volume > 50);

// Deterministic natural publication and update dates to avoid identical footprint
const hVal = Math.abs(hash(p.slug));
const pubDaysAgo = 90 + (hVal % 150);
const modDaysAgo = 3 + (hVal % 22);
const refDate = new Date('2026-10-18T12:00:00Z');
const datePublished = new Date(refDate.getTime() - pubDaysAgo * 86400000).toISOString().split('T')[0];
const dateModified = new Date(refDate.getTime() - modDaysAgo * 86400000).toISOString().split('T')[0];
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const modDateObj = new Date(dateModified);
const displayDate = `${monthNames[modDateObj.getUTCMonth()]} ${modDateObj.getUTCDate()}, ${modDateObj.getUTCFullYear()}`;

const howToSection = c.sections.find(s => s.steps && s.steps.length > 0);
const howToJsonLd = howToSection
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: `${howToSection.h2} - ${titleCase(p.keyword)}`,
        description: c.description,
        totalTime: 'PT10M',
        step: howToSection.steps!.map((stepText, idx) => ({
          '@type': 'HowToStep',
          position: idx + 1,
          name: `Step ${idx + 1}`,
          text: stepText,
        })),
      },
    ]
  : [];

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: catTitle, item: `${SITE.url}/category/${p.category}/` },
      { '@type': 'ListItem', position: 3, name: titleCase(p.keyword), item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: c.h1,
    description: c.description,
    image: [`${SITE.url}/og/og-${SITE.market}.jpg`],
    inLanguage: SITE.locale,
    datePublished,
    dateModified,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
    },
    author: {
      '@type': 'Organization',
      name: `${SITE.name} Editorial Team`,
      url: `${SITE.url}/about/`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  ...howToJsonLd,
  ...(isCommercial
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Product',
          name: `${titleCase(p.keyword)} - ${SITE.name} IPTV`,
          description: c.description,
          image: `${SITE.url}/favicon.svg`,
          brand: { '@type': 'Brand', name: SITE.name },
          offers: {
            '@type': 'AggregateOffer',
            priceCurrency: 'USD',
            lowPrice: '7.50',
            highPrice: '79.99',
            offerCount: '4',
            availability: 'https://schema.org/InStock',
          },
        },
      ]
    : []),
];

// Ring-linked cluster web ensuring zero orphan pages and cross-category discovery
const { related: relatedPages, popular: popularHubs } = getClusterLinks(p, c.related);
---

<Base title={c.title} description={c.description} jsonLd={jsonLd}>
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 30px 24px 80px;">
    <!-- Breadcrumbs Navigation -->
    <nav class="legacy-seo-breadcrumb" aria-label="Breadcrumb">
      <a href="/"><i class="fa-solid fa-house"></i> Home</a>
      <span><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></span>
      <a href={`/category/${p.category}/`}>{catTitle}</a>
      <span><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></span>
      <span style="color: var(--primary-light); font-weight: 600;">{titleCase(p.keyword)}</span>
    </nav>

    <!-- Article Header -->
    <header class="article-header" style="margin-top: 10px; margin-bottom: 30px;">
      <div style="display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;">
        <span class="section-badge"><i class="fa-solid fa-crown"></i> {SITE.year} Master Guide</span>
        <span class="section-badge trust-badge"><i class="fa-solid fa-bolt"></i> Anti-Freeze 9.8</span>
        <span class="section-badge" style="background: rgba(255, 255, 255, 0.08);"><i class="fa-solid fa-signal"></i> 99.98% Uptime</span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 3.8vw, 3.2rem); margin-bottom: 18px; line-height: 1.2;" class="gradient-text">
        {c.h1}
      </h1>
      {c.intro.map(pText => (
        <p class="article-lead"><Fragment set:html={enrichContextLinks(pText, p.slug, isDe)} /></p>
      ))}

      <!-- Editorial Byline & Verification Signals (E-E-A-T) -->
      <div class="eeat-byline-card" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin: 18px 0 28px; padding: 14px 20px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-lg);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1rem;">
            <i class="fa-solid fa-user-shield"></i>
          </div>
          <div>
            <div style="font-size: 0.88rem; font-weight: 700; color: #ffffff;">
              {SITE.name} Systems Engineering Desk
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8; display: flex; align-items: center; gap: 8px;">
              <span><i class="fa-solid fa-calendar-check" style="color: var(--secondary-light);"></i> Verified {displayDate}</span>
              <span>•</span>
              <span><i class="fa-solid fa-microchip" style="color: var(--primary-light);"></i> Lab Tested</span>
            </div>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 0.78rem; color: #cbd5e1; background: rgba(108, 92, 231, 0.15); border: 1px solid rgba(108, 92, 231, 0.3); padding: 4px 10px; border-radius: 999px;">
            <i class="fa-solid fa-clock"></i> ~5 min read
          </span>
          <span style="font-size: 0.78rem; color: var(--success-light); background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 10px; border-radius: 999px;">
            <i class="fa-solid fa-certificate"></i> Fact-Checked
          </span>
        </div>
      </div>

      <!-- Quick Jump Table of Contents (TOC - Structure & UX) -->
      <nav class="article-toc" aria-label="Table of Contents" style="margin-bottom: 34px; padding: 18px 22px; background: rgba(17, 24, 39, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-lg);">
        <div style="font-size: 0.88rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-list-ul" style="color: var(--primary-light);"></i> Jump to Section:
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          {c.sections.map((s, idx) => (
            <a href={`#section-${idx + 1}`} style="font-size: 0.82rem; color: #cbd5e1; text-decoration: none; padding: 5px 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-sm); transition: all 0.2s ease;">
              {idx + 1}. {s.h2.length > 34 ? `${s.h2.slice(0, 32)}...` : s.h2}
            </a>
          ))}
          <a href="#faq-section" style="font-size: 0.82rem; color: #cbd5e1; text-decoration: none; padding: 5px 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-sm);">
            FAQs
          </a>
        </div>
      </nav>
    </header>

    <!-- High-Definition Hero Image -->
    <div class="article-hero-media" style="margin-bottom: 40px; border-radius: var(--radius-xl); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: var(--shadow-xl), 0 0 35px var(--primary-glow);">
      <Img k={heroKey} eager sizes="(max-width: 800px) 100vw, 1100px" alt={c.h1} style="width: 100%; height: auto; max-height: 480px; object-fit: cover; display: block;" />
    </div>

    <!-- Key Technical Specifications Card -->
    {c.specs && c.specs.length > 0 && (
      <div class="glass-card premium-card" style="margin-bottom: 40px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
          <h2 style="font-size: 1.35rem; margin: 0; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-sliders" style="color: var(--primary-light);"></i>
            Key Specifications & Benchmarks
          </h2>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--success-light); background: rgba(0, 184, 148, 0.15); padding: 4px 10px; border-radius: 999px;">
            <i class="fa-solid fa-circle-check"></i> Verified {SITE.year}
          </span>
        </div>
        <div class="specs-grid">
          {c.specs.map(s => (
            <div class="spec-box">
              <i class={`fa-solid ${s.icon}`} style="font-size: 1.4rem; color: var(--primary-light); margin-bottom: 6px;"></i>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))}
        </div>
        <div style="display: flex; gap: 14px; margin-top: 24px; flex-wrap: wrap;">
          <a href={SITE.trialUrl} class="btn btn-primary" target="_blank" rel="nofollow noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> Test Free Trial Now
          </a>
          <a href={SITE.orderUrl} class="btn btn-secondary" target="_blank" rel="nofollow noopener noreferrer">
            <i class="fa-solid fa-store"></i> Become a Reseller
          </a>
        </div>
      </div>
    )}

    <!-- Main Content Sections -->
    <article class="article-body">
      {c.sections.map((s, idx) => (
        <>
          <section class="content-block" id={`section-${idx + 1}`} style="margin-bottom: 40px;">
            <h2 style="font-size: 1.7rem; margin-bottom: 18px; color: #ffffff; display: flex; align-items: center; gap: 10px;">
              <i class="fa-solid fa-circle-play" style="color: var(--primary-light); font-size: 1.1rem;"></i>
              {s.h2}
            </h2>

            {s.paras && s.paras.map(para => (
              <p style="font-size: 1.05rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: 16px;">
                <Fragment set:html={enrichContextLinks(para, p.slug, isDe)} />
              </p>
            ))}

            {s.list && (
              <ul style="list-style: none; padding: 0; margin: 16px 0 24px; display: flex; flex-direction: column; gap: 10px;">
                {s.list.map(li => (
                  <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 1rem; color: var(--text-secondary); line-height: 1.6;">
                    <i class="fa-solid fa-check-circle" style="color: var(--success); margin-top: 4px; flex-shrink: 0;"></i>
                    <span>{li}</span>
                  </li>
                ))}
              </ul>
            )}

            {s.steps && (
              <div style="display: flex; flex-direction: column; gap: 14px; margin: 20px 0;">
                {s.steps.map((st, i) => (
                  <div style="display: flex; gap: 16px; padding: 18px 20px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-md);">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--gradient-primary); color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; flex-shrink: 0;">
                      {i + 1}
                    </div>
                    <div style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; align-self: center;">
                      {st}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>

          {/* Inline Media Banner inserted after first section */}
          {idx === 0 && (
            <div class="article-inline-media" style="margin: 36px 0 44px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: var(--shadow-lg);">
              <Img k={inlineKey} sizes="(max-width: 800px) 100vw, 900px" alt={`${titleCase(p.keyword)} Streaming Setup`} style="width: 100%; height: auto; max-height: 400px; object-fit: cover; display: block;" />
            </div>
          )}
        </>
      ))}

      <!-- Pros and Cons Matrix -->
      {c.pros && c.pros.length > 0 && (
        <section style="margin-bottom: 40px;">
          <h2 style="font-size: 1.7rem; margin-bottom: 18px; color: #ffffff;">
            Pros & Cons Analysis
          </h2>
          <div class="pros-cons-grid">
            <div class="pros-card">
              <h3><i class="fa-solid fa-thumbs-up"></i> Key Advantages</h3>
              <ul>
                {c.pros.map(pr => (
                  <li><i class="fa-solid fa-check"></i> {pr}</li>
                ))}
              </ul>
            </div>
            <div class="cons-card">
              <h3><i class="fa-solid fa-triangle-exclamation"></i> Things to Keep in Mind</h3>
              <ul>
                {c.cons.map(cn => (
                  <li><i class="fa-solid fa-xmark"></i> {cn}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      <!-- Executive Verdict Box -->
      {c.verdict && (
        <div class="glass-card" style="background: rgba(108, 92, 231, 0.08); border: 1px solid rgba(108, 92, 231, 0.3); margin-bottom: 48px;">
          <h3 style="font-size: 1.3rem; margin-bottom: 12px; color: var(--primary-light); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-award"></i> The {SITE.name} Verdict
          </h3>
          <p style="font-size: 1.05rem; line-height: 1.8; color: var(--text-secondary); margin: 0;">
            <Fragment set:html={enrichContextLinks(c.verdict, p.slug, isDe)} />
          </p>
        </div>
      )}

      <!-- Subscription Pricing Plans for this Topic -->
      <PricingSection id="pricing" contextKeyword={titleCase(p.keyword)} />

      <!-- Dynamic FAQ Section -->
      <section id="faq-section" style="margin-bottom: 50px;">
        <h2 style="font-size: 1.8rem; margin-bottom: 24px; color: #ffffff; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-circle-question" style="color: var(--primary-light);"></i>
          Frequently Asked Questions About {titleCase(p.keyword)}
        </h2>
        <div class="faq-grid" style="grid-template-columns: 1fr;">
          {c.faqs.map(f => (
            <div class="faq-item">
              <h3><i class="fa-solid fa-question"></i> {f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Contextual Internal Linking Web (Crucial for Crawling 5000 Pages) -->
      <section style="margin-top: 60px; padding-top: 36px; border-top: 1px solid rgba(255, 255, 255, 0.1);">
        <h3 style="font-size: 1.35rem; margin-bottom: 20px; color: #ffffff; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-network-wired" style="color: var(--secondary-light);"></i>
          Explore Related Guides in {catTitle}
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 14px; margin-bottom: 30px;">
          {relatedPages.map(rp => (
            <a href={`/${rp.slug}/`} style="padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-md); text-decoration: none; color: var(--text-secondary); font-size: 0.9rem; transition: all var(--transition-fast); display: flex; align-items: center; justify-content: space-between;">
              <span>{titleCase(rp.keyword)}</span>
              <i class="fa-solid fa-arrow-right" style="font-size: 0.75rem; color: var(--primary-light);"></i>
            </a>
          ))}
        </div>

        <h4 style="font-size: 1.1rem; margin-bottom: 14px; color: var(--text-secondary);">
          Popular Across Other Categories:
        </h4>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          {popularHubs.map(ph => (
            <a href={`/${ph.slug}/`} style="padding: 6px 14px; background: rgba(108, 92, 231, 0.1); border: 1px solid rgba(108, 92, 231, 0.2); border-radius: 999px; font-size: 0.85rem; color: var(--primary-light); text-decoration: none;">
              {titleCase(ph.keyword)}
            </a>
          ))}
        </div>

        <!-- Category Hub Bridge Link -->
        <div style="margin-top: 24px; text-align: center;">
          <a href={`/category/${p.category}/`} style="display: inline-flex; align-items: center; gap: 8px; color: var(--secondary-light); font-weight: 700; font-size: 0.92rem; text-decoration: none; padding: 10px 22px; background: rgba(0, 206, 201, 0.1); border: 1px solid rgba(0, 206, 201, 0.25); border-radius: var(--radius-full);">
            <i class="fa-solid fa-folder-open"></i> Browse Complete {catTitle} Directory ({byCategory(p.category).length}+ Guides) <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </section>

      <!-- Backlink & Citation Tool (Syndication & Link Equity) -->
      <div class="citation-box" style="margin: 40px 0; padding: 22px 24px; background: rgba(15, 23, 42, 0.85); border: 1px dashed rgba(108, 92, 231, 0.4); border-radius: var(--radius-lg);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
          <span style="font-size: 0.92rem; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-quote-left" style="color: var(--secondary-light);"></i> Cite this Research & Technical Benchmark
          </span>
          <button type="button" id="copyCitationBtn" class="btn btn-outline btn-sm" style="font-size: 0.78rem; padding: 5px 14px; cursor: pointer;">
            <i class="fa-regular fa-copy"></i> Copy Citation
          </button>
        </div>
        <p style="font-size: 0.84rem; color: #94a3b8; margin: 0 0 10px; line-height: 1.5;">
          Publishing or discussing this topic on Reddit, tech forums, or blogs? Feel free to reference our benchmark findings:
        </p>
        <div style="background: rgba(0, 0, 0, 0.35); padding: 10px 14px; border-radius: var(--radius-sm); font-family: monospace; font-size: 0.82rem; color: #a5b4fc; word-break: break-all;" id="citationSnippet">
          [{SITE.name}: {c.h1}]({url})
        </div>
      </div>

      <!-- Sticky Conversion Banner -->
      <div class="glass-card" style="margin-top: 50px; text-align: center; padding: 40px 30px; border: 1px solid rgba(108, 92, 231, 0.4); background: linear-gradient(145deg, rgba(108, 92, 231, 0.15) 0%, rgba(0, 206, 201, 0.1) 100%);">
        <h3 style="font-size: 1.6rem; margin-bottom: 12px; color: #ffffff;">
          Start Streaming or Launch Your Reseller Panel Today
        </h3>
        <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto 24px; font-size: 1.05rem;">
          Get your 24-hour test line or purchase wholesale reseller credits directly with instant WhatsApp setup.
        </p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href={SITE.orderUrl} class="btn btn-whatsapp btn-lg" target="_blank" rel="nofollow noopener noreferrer">
            <i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp ({SITE.phone})
          </a>
          <a href={SITE.trialUrl} class="btn btn-secondary btn-lg" target="_blank" rel="nofollow noopener noreferrer">
            <i class="fa-solid fa-clock"></i> Request 24h Free Trial
          </a>
        </div>
      </div>
    </article>
  </div>
</Base>

<script>
  const copyBtn = document.getElementById('copyCitationBtn');
  const snippet = document.getElementById('citationSnippet');
  if (copyBtn && snippet) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(snippet.textContent?.trim() || '');
        const orig = copyBtn.innerHTML;
        copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
        setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
      } catch (e) {
        // Fallback
      }
    });
  }
</script>
