---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { T, fillLegal } from '../i18n';
const page = T.legal.imprint;
---
<Base title={`${page.title} | ${SITE.name}`} description={`${page.title} · ${SITE.name}`} noindex={true}>
  <div class="wrap"><article><h1>{page.title}</h1><Fragment set:html={fillLegal(page.html)} /></article></div>
</Base>
